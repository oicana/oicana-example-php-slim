{
    "name": "oicana/example-php",
    "description": "PHP example service using Oicana for PDF templating",
    "type": "project",
    "license": "MIT",
    "repositories": [
      {
          "type": "composer",
          "url": "https://composer.oicana.com"
      }
    ],
    "require": {
        "php": "^8.3",
        "oicana/oicana": "^0.1.0-alpha.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "ramsey/uuid": "^4.7",
        "zircote/swagger-php": "^6.0",
        "swagger-api/swagger-ui": "^5.31",
        "spiral/roadrunner-http": "^4.1",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "oicana/installer": true
        }
    }
}
